# Copy to `.env` for local `netlify dev`, and set the same names in
# Netlify > Site configuration > Environment variables for the deployed site.
#
# .env is gitignored. Never put any of these in src/ - the Angular bundle is
# public, and anything in it is readable by every visitor.

# --- Translator resource -----------------------------------------------------
# Azure portal > your Translator resource > Keys and Endpoint
AZURE_TRANSLATOR_KEY=your-translator-key
# Use the *Document Translation* endpoint, not the global api.cognitive one:
AZURE_TRANSLATOR_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com
# Optional, but required for multi-service or regional resources:
AZURE_TRANSLATOR_REGION=eastus

# --- Storage account ---------------------------------------------------------
# Azure portal > your storage account > Security + networking > Access keys
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-key
AZURE_SOURCE_CONTAINER=source
AZURE_TARGET_CONTAINER=target

# --- App ---------------------------------------------------------------------
# Any long random string. Signs the tokens that stop one visitor from reading
# another visitor's translated document. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=change-me-to-a-long-random-string
